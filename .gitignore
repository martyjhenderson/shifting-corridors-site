# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.vscode
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# wrangler local secrets -- INVITE_SECRET, TURNSTILE_SECRET and the GitHub App
# private key live here when running `wrangler dev`. Never commit them.
#
# Matched with and without the leading dot. Only `.dev.vars` is the name
# wrangler actually reads, but a file named `dev.vars` holds exactly the same
# private key and was not covered by the first version of this rule.
.dev.vars
dev.vars
**/.dev.vars
**/dev.vars
!**/.dev.vars.example

# wrangler's local state and build cache
.wrangler/
**/.wrangler/
