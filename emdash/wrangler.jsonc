{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shifting-corridors",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// The public origin. EmDash refuses to run setup without it, and binds
	// passkeys to it. Change it to https://shiftingcorridors.com at cutover
	// (see README.md, "Moving to shiftingcorridors.com").
	"vars": {
		"EMDASH_SITE_URL": "https://shifting-corridors.ravegrunt.workers.dev",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shifting-corridors",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "shifting-corridors-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
