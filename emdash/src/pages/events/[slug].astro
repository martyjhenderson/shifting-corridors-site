---
// The event page from ../src/components/EventDetails.tsx, at the same URL.
// Everything above the extra sections is generated from the fields.
import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import {
	formatEventDate,
	formatRegistrationNote,
	formatScenarioTags,
	formatTimeRange,
} from "../../utils/eventFormat";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry, cacheHint, error } = await getEmDashEntry("events", slug);
if (error) throw error;
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const event = entry.data;
const scenarios = event.scenarios ?? [];
const timeRange = formatTimeRange(event);
const registrationNote = formatRegistrationNote(event);
---

<Layout title={event.title} description={event.intro}>
	<a href="/" class="back-button">Back to Calendar</a>
	<div class="card event-container">
		<h1>{event.title}</h1>

		{event.cancelled && <p class="cancelled-banner">This event has been cancelled.</p>}

		{event.intro && <p>{event.intro}</p>}

		<h2>Details</h2>
		<ul>
			<li><strong>Date:</strong> {formatEventDate(event.date)}</li>
			{timeRange && <li><strong>Time:</strong> {timeRange}</li>}
			{event.location && <li><strong>Location:</strong> {event.location}</li>}
			{event.address && <li><strong>Address:</strong> {event.address}</li>}
			{event.levels && <li><strong>Level Range:</strong> {event.levels}</li>}
			{event.player_cap && <li><strong>Players:</strong> {event.player_cap} players</li>}
			{event.gamemaster && <li><strong>Game Master:</strong> {event.gamemaster}</li>}
			{event.special_note && <li><strong>Special Note:</strong> {event.special_note}</li>}
		</ul>

		{
			scenarios.length > 0 && (
				<>
					<h2>{scenarios.length === 1 ? "Scenario" : "Available Scenarios"}</h2>
					<ol class="scenario-list">
						{scenarios.map((scenario) => {
							const tags = formatScenarioTags(scenario);
							return (
								<li>
									<strong>{scenario.name}</strong>
									{tags && <span class="scenario-tags"> ({tags})</span>}
									{scenario.gamemaster && <span> — GM: {scenario.gamemaster}</span>}
									{scenario.cancelled ? (
										<span class="scenario-cancelled"> — Cancelled</span>
									) : (
										scenario.signup_url && (
											<>
												{" — "}
												<a href={scenario.signup_url} target="_blank" rel="noopener noreferrer">
													Sign up here
												</a>
											</>
										)
									)}
								</li>
							);
						})}
					</ol>
				</>
			)
		}

		{
			registrationNote && (
				<>
					<h2>Registration</h2>
					<p>{registrationNote}</p>
				</>
			)
		}

		{event.body && event.body.length > 0 && <PortableText value={event.body} />}
	</div>
</Layout>
