---
// Placeholder event page at the same URL as today's /events/<slug>. It shows
// every field so the schema can be checked; the real EventDetails layout is
// ported from the React site in a later step.
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { entry: event, cacheHint, error } = await getEmDashEntry("events", slug);
if (error) throw error;
if (!event) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const d = event.data;
const time = d.all_day ? "All day" : [d.start_time, d.end_time].filter(Boolean).join("–");
---

<Base
	title={d.title}
	description={d.intro}
	content={{ collection: "events", id: event.data.id, slug: event.id }}
>
	<article {...event.edit}>
		<h1>{d.title}</h1>
		{d.cancelled && <p><strong>This event has been cancelled.</strong></p>}
		{d.intro && <p>{d.intro}</p>}
		<dl>
			<dt>Date</dt><dd>{d.date}{time && ` · ${time}`}</dd>
			{d.location && <><dt>Location</dt><dd>{d.location}</dd></>}
			{d.address && <><dt>Address</dt><dd>{d.address}</dd></>}
			{d.levels && <><dt>Levels</dt><dd>{d.levels}</dd></>}
			{d.player_cap && <><dt>Players</dt><dd>{d.player_cap}</dd></>}
			{d.gamemaster && <><dt>Game Master</dt><dd>{d.gamemaster}</dd></>}
			{d.special_note && <><dt>Note</dt><dd>{d.special_note}</dd></>}
		</dl>
		{
			d.scenarios && d.scenarios.length > 0 && (
				<ul>
					{d.scenarios.map((s) => (
						<li>
							{s.signup_url && !s.cancelled ? <a href={s.signup_url}>{s.name}</a> : s.name}
							{s.cancelled && " (cancelled)"}
							{[s.system, s.edition, s.type, s.levels && `levels ${s.levels}`, s.gamemaster && `GM ${s.gamemaster}`]
								.filter(Boolean)
								.join(" · ")}
						</li>
					))}
				</ul>
			)
		}
		{d.body && <PortableText value={d.body} />}
	</article>
</Base>
