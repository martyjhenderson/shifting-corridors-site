---
// The home page from ../src/App.tsx: calendar, about, and news in the main
// column; contact and Game Masters in the sidebar.
import About from "../components/About.astro";
import Calendar from "../components/Calendar";
import Contact from "../components/Contact.astro";
import GameMasters from "../components/GameMasters.astro";
import News from "../components/News.astro";
import Layout from "../layouts/Layout.astro";
import { getAllEntries } from "../utils/content";

const [events, news, gamemasters] = await Promise.all([
	getAllEntries("events", { orderBy: { date: "desc" } }),
	getAllEntries("news", { orderBy: { date: "desc" } }),
	getAllEntries("gamemasters", { orderBy: { first_name: "asc" } }),
]);
if (Astro.cache?.enabled) {
	for (const hint of [...events.cacheHints, ...news.cacheHints, ...gamemasters.cacheHints]) Astro.cache.set(hint);
}

const calendarEvents = events.entries.map((e) => ({ date: e.data.date, title: e.data.title, slug: e.id }));
---

<Layout>
	<div class="main-grid">
		<main class="main-content">
			<Calendar client:load events={calendarEvents} />
			<About />
			<News articles={news.entries} />
		</main>
		<aside class="sidebar">
			<Contact />
			<GameMasters gamemasters={gamemasters.entries} />
		</aside>
	</div>
</Layout>
